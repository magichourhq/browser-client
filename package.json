{
  "name": "@magichourhq/browser-client",
  "version": "0.3.2",
  "description": "Browser client for the Magic Hour API",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/browser-client.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@magichourhq/api-types": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
