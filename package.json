{
  "name": "@magichourhq/browser-client",
  "version": "0.0.0-dev.2",
  "description": "Browser client for the Magic Hour API",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages_en.json": "./dist/messages_en.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/browser-client.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-messages.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@magichourhq/api-types": "0.1.1"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.35",
    "@formatjs/unplugin": "1.2.14",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
